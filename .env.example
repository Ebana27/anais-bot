GEMINI_API_KEY=colle_ta_cle_gemini_ici
GEMINI_MODEL=gemini-3.5-flash-lite
# Optionnel : compte Cloudflare Workers AI pour les commandes /image
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
ANAIS_OWNER_NAME=ton_prenom
ANAIS_OWNER_NUMBER=24206XXXXXXXX
# Laisse vide pour autoriser tous les groupes. Sinon, liste les identifiants séparés par des virgules.
WHATSAPP_GROUPS=
# Probabilité minimale de réponse spontanée et délai maximal entre deux interventions par groupe.
AMBIENT_REPLY_CHANCE=0.70
MIN_AMBIENT_GAP_MS=15000
# Courte pause avant réponse ; les lots se ferment après 5 secondes au maximum.
MIN_REPLY_DELAY_MS=10000
MAX_REPLY_DELAY_MS=60000
MESSAGE_BATCH_WINDOW_MS=1800
