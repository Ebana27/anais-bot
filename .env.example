GEMINI_API_KEY=colle_ta_cle_gemini_ici
GEMINI_MODEL=gemini-3.5-flash-lite
ANAIS_OWNER_NAME=ton_prenom
ANAIS_OWNER_NUMBER=24206XXXXXXXX
# Laisse vide pour autoriser tous les groupes. Sinon, liste les identifiants séparés par des virgules.
WHATSAPP_GROUPS=
# Peut parfois rebondir sans être interpellée (5 % des messages, max. une fois/90 secondes/groupe).
AMBIENT_REPLY_CHANCE=0.45
MIN_AMBIENT_GAP_MS=30000
# Délai naturel avant une réponse et pause entre deux réponses du groupe.
MIN_REPLY_DELAY_MS=800
MAX_REPLY_DELAY_MS=1800
MESSAGE_BATCH_WINDOW_MS=1200
